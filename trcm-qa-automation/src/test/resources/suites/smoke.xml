<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  SMOKE suite: a quick health check (about 15 tests, a few minutes).
  Runs on every commit / pull request. If smoke fails, there is no point running regression.
  Command: mvn clean test -Dsuite=src/test/resources/suites/smoke.xml
-->
<suite name="TRCM Smoke" verbose="1">
    <listeners>
        <listener class-name="com.trcm.qa.listeners.TestListener"/>
        <listener class-name="com.trcm.qa.listeners.RetryTransformer"/>
    </listeners>
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.trcm.qa.tests.ui.EnvironmentTest"/>
            <class name="com.trcm.qa.tests.ui.FileUploadTest"/>
            <class name="com.trcm.qa.tests.ui.RunReviewTest"/>
            <class name="com.trcm.qa.tests.ui.ClaimGridTest"/>
            <class name="com.trcm.qa.tests.ui.ClaimDetailTest"/>
            <class name="com.trcm.qa.tests.ui.PredictionTest"/>
            <class name="com.trcm.qa.tests.ui.ExportTest"/>
            <class name="com.trcm.qa.tests.ui.RevalidateTest"/>
            <class name="com.trcm.qa.tests.ui.BulkChatTest"/>
            <class name="com.trcm.qa.tests.ui.ClaimChatTest"/>
            <class name="com.trcm.qa.tests.api.ApimAuthTest"/>
        </classes>
    </test>
</suite>
