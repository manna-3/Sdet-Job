<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  API suite: APIM authentication tests only. No browser, runs in seconds.
  Command: mvn clean test -Dsuite=src/test/resources/suites/api.xml
-->
<suite name="TRCM APIM API" verbose="1">
    <listeners>
        <listener class-name="com.trcm.qa.listeners.TestListener"/>
        <listener class-name="com.trcm.qa.listeners.RetryTransformer"/>
    </listeners>
    <test name="APIM Auth">
        <classes>
            <class name="com.trcm.qa.tests.api.ApimAuthTest"/>
        </classes>
    </test>
</suite>
